{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Orb 与主窗口的默认权限（含无边框窗口拖拽）",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-position",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "shell:allow-open",
    "autostart:default",
    "store:default"
  ]
}
